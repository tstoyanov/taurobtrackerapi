<?xml version="1.0"?>
<package format="3">
  <name>libtaurob</name>
  <version>0.0.1</version>
  <description>Low-level functions to talk to the taurob U-ECU.</description>

  <maintainer email="office@taurob.com">taurob GmbH</maintainer>

  <license>3-clause BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>diagnostic_updater</depend>
  <depend>diagnostic_msgs</depend>
  <depend>libboost-dev</depend>
  <depend>libboost-thread-dev</depend>
  <depend>libboost-system-dev</depend>
  <depend>libboost-date-time-dev</depend>
  <depend>libboost-regex-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
