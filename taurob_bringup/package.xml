<?xml version="1.0"?>
<package format="3">
  <name>taurob_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and controller configurations for the taurob tracker robot (ROS 2).</description>

  <maintainer email="office@taurob.com">taurob GmbH</maintainer>

  <license>3-clause BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>taurob_tracker_description</exec_depend>
  <exec_depend>taurob_tracker_hardware</exec_depend>
  <exec_depend>taurob_watchdog</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
