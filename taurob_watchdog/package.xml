<?xml version="1.0"?>
<package format="3">
  <name>taurob_watchdog</name>
  <version>0.1.0</version>
  <description>Watchdog node for the other taurob packages.</description>

  <maintainer email="office@taurob.com">taurob GmbH</maintainer>

  <license>3-clause BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>libtaurob</depend>
  <depend>libboost-date-time-dev</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
